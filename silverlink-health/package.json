{
  "name": "silverlink-health",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:functions": "npm --prefix functions test",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/emulator/firestoreRules.test.js\"",
    "test:all": "npm test && npm run test:functions && npm run test:rules"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "chart.js": "^4.5.1",
    "firebase": "^12.16.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "vue": "^3.5.39",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "firebase-tools": "^15.27.0",
    "vite": "^8.1.1"
  }
}
